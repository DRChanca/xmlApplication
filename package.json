{
  "name": "generador-web-xml",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "generate": "npm run build && node dist/generate.js",
    "serve": "npm run build && node server.js",
    "build:wasm": "cargo build --manifest-path wasm-validator/Cargo.toml --target wasm32-unknown-unknown --release",
    "test": "npm run build && node --test dist/generate.test.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3"
  }
}
